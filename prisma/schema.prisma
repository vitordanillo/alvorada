datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  status         String            @default("Ativa")
  memberships    StoreMembership[]
  settings       SystemConfig[]

  users               User[]
  products            Product[]
  suppliers           Supplier[]
  customers           Customer[]
  sales               Sale[]
  cashSessions        CashRegisterSession[]
  cashTransactions    CashTransaction[]
  stockAdjustmentLogs StockAdjustmentLog[]
  stockEntryLogs      StockEntryLog[]
  productChangeLogs   ProductChangeLog[]
  accountsPayable     AccountsPayable[]
  purchaseOrders      PurchaseOrder[]
  auditLogs           AuditLog[]
  subscription        Subscription?

  @@index([organizationId])
}

model User {
  uid             String            @id
  name            String
  email           String            @unique
  isPlatformAdmin Boolean           @default(false)
  disabled        Boolean           @default(false)
  mustChangePassword Boolean @default(false)
  sessionVersion  Int               @default(0)
  memberships     StoreMembership[]
  passwordHash    String
  role            String // 'Administrador' | 'Gerente' | 'Operador de Caixa' | 'Estoquista'
  avatarUrl       String?           @db.VarChar(500)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  storeId         String?
  store           Store?            @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model SystemConfig {
  key     String @id
  value   Json
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId])
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String?   @db.Text
  brand       String?
  sku         String
  status      String // 'Ativo' | 'Inativo'
  category    String // 'Alimentos' | 'Limpeza' | 'Higiene' | 'Bebidas' | 'Outros'
  price       Float
  averageCost Float
  costHistory Json // Array<{ date: string, quantity: number, cost: number }>
  stock       Float
  minStock    Float
  measurement Json?
  unit        String
  supplier    String
  barcode     String?
  imageUrl    String?   @db.VarChar(500)
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, sku])
  @@unique([storeId, id])
  @@index([storeId])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  cnpj        String?
  tradeName   String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  notes       String?  @db.Text
  contactName String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, id])
  @@index([storeId])
}

model Customer {
  id            String    @id @default(uuid())
  name          String
  cpfCnpj       String?
  birthDate     DateTime?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  phone         String
  email         String?
  creditLimit   Float
  balance       Float
  notes         String?   @db.Text
  tags          Json // string[]
  loyaltyPoints Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, id])
  @@index([storeId])
}

model Sale {
  id                    String    @id @default(uuid())
  date                  DateTime  @default(now())
  items                 Json // Array<{ productId: string, productName: string, quantity: number, price: number, costAtTimeOfSale?: number }>
  total                 Float
  totalCost             Float?
  totalProfit           Float?
  customerId            String
  customerName          String
  paymentMethods        Json // Array<{ method: 'Dinheiro' | 'Pix' | 'Cartão' | 'Fiado', amount: number }>
  cashRegisterSessionId String?
  status                String // 'Concluída' | 'Cancelada'
  cancellationReason    String?   @db.Text
  cancelledByUid        String?
  cancelledByName       String?
  cancellationDate      DateTime?
  storeId               String
  store                 Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  storeSnapshot         Json?
  clientRequestId       String?

  @@unique([storeId, clientRequestId])
  @@index([storeId, date])
  @@index([storeId, cashRegisterSessionId])
  @@index([storeId, customerId])
}

model CashRegisterSession {
  id                     String    @id @default(uuid())
  openingTime            DateTime  @default(now())
  closingTime            DateTime?
  openingBalance         Float
  closingBalance         Float?
  calculatedCashInDrawer Float
  totalSales             Float
  salesByPaymentMethod   Json // { Dinheiro: number, Pix: number, Cartão: number }
  totalExpenses          Float
  totalWithdrawals       Float
  totalCreditPayments    Float
  status                 String // 'Aberto' | 'Fechado'
  openedByUid            String
  openedByName           String
  closedByUid            String?
  closedByName           String?
  correction             Json? // { date: string, user: { uid: string, name: string }, oldValue: number, newValue: number }
  closingByPaymentMethod Json?
  openingCorrection      Json? // { date: string, user: { uid: string, name: string }, oldValue: number, newValue: number }
  storeId                String
  store                  Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, id])
  @@index([storeId, openingTime])
}

model CashTransaction {
  id               String   @id @default(uuid())
  sessionId        String
  type             String // 'Despesa' | 'Sangria' | 'Recebimento Fiado'
  amount           Float
  description      String
  date             DateTime @default(now())
  registeredByUid  String
  registeredByName String
  customerId       String?
  customerName     String?
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  storeSnapshot    Json?

  @@index([storeId, sessionId, date])
  @@index([storeId, customerId])
}

model StockAdjustmentLog {
  id             String   @id @default(uuid())
  productId      String
  productName    String
  adjustedByUid  String
  adjustedByName String
  date           DateTime @default(now())
  oldQuantity    Float
  newQuantity    Float
  reason         String // 'Perda' | 'Avaria' | 'Contagem' | 'Doação' | 'Outro'
  notes          String?  @db.Text
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, date])
  @@index([storeId, productId])
}

model StockEntryLog {
  id               String   @id @default(uuid())
  date             DateTime @default(now())
  supplierId       String
  supplierName     String
  items            Json // Array<{ productId: string, productName: string, quantity: number, cost: number }>
  totalCost        Float
  totalItems       Float
  registeredByUid  String
  registeredByName String
  purchaseOrderId  String?
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, date])
  @@index([storeId, purchaseOrderId])
  @@index([storeId, supplierId])
}

model ProductChangeLog {
  id            String   @id @default(uuid())
  date          DateTime @default(now())
  productId     String
  productName   String
  changedByUid  String
  changedByName String
  changes       Json // Array<{ field: string, oldValue: any, newValue: any }>
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, date])
  @@index([storeId, productId])
}

model AccountsPayable {
  id               String    @id @default(uuid())
  description      String
  amount           Float
  category         String? // 'Aluguel' | 'Energia' | 'Água' | 'Internet' | 'Fornecedor' | 'Salários' | 'Impostos' | 'Outros'
  dateCreated      DateTime  @default(now())
  dueDate          DateTime
  paymentDate      DateTime?
  status           String // 'Pendente' | 'Pago' | 'Vencido'
  supplierId       String?
  supplierName     String?
  registeredByUid  String
  registeredByName String
  cashSessionId    String?
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, dueDate])
  @@index([storeId, cashSessionId])
  @@index([storeId, supplierId])
}

model PurchaseOrder {
  id               String    @id @default(uuid())
  supplierId       String
  supplierName     String
  dateCreated      DateTime  @default(now())
  dateExpected     DateTime
  dateReceived     DateTime?
  status           String // 'Pendente' | 'Recebido Parcialmente' | 'Recebido' | 'Cancelado'
  items            Json // Array<{ productId: string, productName: string, quantityOrdered: number, cost: number, quantityReceived: number }>
  totalCost        Float
  registeredByUid  String
  registeredByName String
  notes            String?   @db.Text
  storeId          String
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, id])
  @@index([storeId, dateCreated])
  @@index([storeId, supplierId])
}

model AuditLog {
  id       String   @id @default(uuid())
  date     DateTime @default(now())
  action   String
  details  String   @db.Text
  userUid  String
  userName String
  storeId  String
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, date])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  stores    Store[]
}

model StoreMembership {
  userId    String
  storeId   String
  role      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [uid], onDelete: Restrict)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@id([userId, storeId])
  @@index([storeId, role])
}

model PlatformAuditLog {
  id            String   @id @default(uuid())
  date          DateTime @default(now())
  action        String
  details       String   @db.Text
  actorId       String
  actorName     String
  targetStoreId String?

  @@index([date])
}

model Plan {
  id String @id @default(uuid())
  name String
  priceCents Int
  maxUsers Int @default(5)
  active Boolean @default(true)
  description String @default("")
  createdAt DateTime @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id String @id @default(uuid())
  storeId String @unique
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  planId String
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  priceCents Int
  maxUsers Int
  status String @default("Ativa")
  startedAt DateTime @default(now())
  nextDue DateTime
  billingDay Int
  notes String @default("")
  updatedAt DateTime @updatedAt
  invoices Invoice[]
  @@index([status, nextDue])
}

model Invoice {
  id String @id @default(uuid())
  subscriptionId String
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  dueDate DateTime
  amountCents Int
  status String @default("Pendente")
  paidAt DateTime?
  paymentMethod String?
  paymentReference String?
  notes String @default("")
  createdAt DateTime @default(now())
  attachments InvoiceAttachment[]
  @@unique([subscriptionId, dueDate])
  @@index([status, dueDate])
}

model InvoiceAttachment {
 id String @id @default(uuid())
 invoiceId String
 invoice Invoice @relation(fields:[invoiceId], references:[id], onDelete:Restrict)
 filename String
 mimeType String
 size Int
 createdAt DateTime @default(now())
 uploadedBy String
 @@index([invoiceId])
}
