datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  id        String   @id @default(uuid())
  name      String
  cnpj      String?
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  products              Product[]
  suppliers             Supplier[]
  customers             Customer[]
  sales                 Sale[]
  cashSessions          CashRegisterSession[]
  cashTransactions      CashTransaction[]
  stockAdjustmentLogs   StockAdjustmentLog[]
  stockEntryLogs        StockEntryLog[]
  productChangeLogs     ProductChangeLog[]
  accountsPayable       AccountsPayable[]
  purchaseOrders        PurchaseOrder[]
  auditLogs             AuditLog[]
}

model User {
  uid          String   @id
  name         String
  email        String   @unique
  passwordHash String
  role         String   // 'Administrador' | 'Gerente' | 'Operador de Caixa' | 'Estoquista'
  avatarUrl    String?  @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model SystemConfig {
  key   String @id
  value Json   // Hashed security settings and counters.
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String?   @db.Text
  brand       String?
  sku         String    @unique
  status      String    // 'Ativo' | 'Inativo'
  category    String    // 'Alimentos' | 'Limpeza' | 'Higiene' | 'Bebidas' | 'Outros'
  price       Float
  averageCost Float
  costHistory Json      // Array<{ date: string, quantity: number, cost: number }>
  stock       Float
  minStock    Float
  unit        String
  supplier    String
  barcode     String?
  imageUrl    String?   @db.VarChar(500)
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  storeId     String?
  store       Store?    @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  cnpj        String?
  tradeName   String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  notes       String?  @db.Text
  contactName String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model Customer {
  id            String    @id @default(uuid())
  name          String
  cpfCnpj       String?
  birthDate     DateTime?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  phone         String
  email         String?
  creditLimit   Float
  balance       Float
  notes         String?   @db.Text
  tags          Json      // string[]
  loyaltyPoints Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  storeId       String?
  store         Store?    @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model Sale {
  id                    String    @id @default(uuid())
  date                  DateTime  @default(now())
  items                 Json      // Array<{ productId: string, productName: string, quantity: number, price: number, costAtTimeOfSale?: number }>
  total                 Float
  totalCost             Float?
  totalProfit           Float?
  customerId            String
  customerName          String
  paymentMethods        Json      // Array<{ method: 'Dinheiro' | 'Pix' | 'Cartão' | 'Fiado', amount: number }>
  cashRegisterSessionId String?
  status                String    // 'Concluída' | 'Cancelada'
  cancellationReason    String?   @db.Text
  cancelledByUid        String?
  cancelledByName       String?
  cancellationDate      DateTime?
  storeId               String?
  store                 Store?    @relation(fields: [storeId], references: [id])

  @@index([storeId, date])
}

model CashRegisterSession {
  id                     String    @id @default(uuid())
  openingTime            DateTime  @default(now())
  closingTime            DateTime?
  openingBalance         Float
  closingBalance         Float?
  calculatedCashInDrawer Float
  totalSales             Float
  salesByPaymentMethod   Json      // { Dinheiro: number, Pix: number, Cartão: number }
  totalExpenses          Float
  totalWithdrawals       Float
  totalCreditPayments    Float
  status                 String    // 'Aberto' | 'Fechado'
  openedByUid            String
  openedByName           String
  closedByUid            String?
  closedByName           String?
  correction             Json?     // { date: string, user: { uid: string, name: string }, oldValue: number, newValue: number }
  openingCorrection      Json?     // { date: string, user: { uid: string, name: string }, oldValue: number, newValue: number }
  storeId                String?
  store                  Store?    @relation(fields: [storeId], references: [id])

  @@index([storeId, openingTime])
}

model CashTransaction {
  id               String   @id @default(uuid())
  sessionId        String
  type             String   // 'Despesa' | 'Sangria' | 'Recebimento Fiado'
  amount           Float
  description      String
  date             DateTime @default(now())
  registeredByUid  String
  registeredByName String
  customerId       String?
  customerName     String?
  storeId          String?
  store            Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId, sessionId, date])
}

model StockAdjustmentLog {
  id             String   @id @default(uuid())
  productId      String
  productName    String
  adjustedByUid  String
  adjustedByName String
  date           DateTime @default(now())
  oldQuantity    Float
  newQuantity    Float
  reason         String   // 'Perda' | 'Avaria' | 'Contagem' | 'Doação' | 'Outro'
  notes          String?  @db.Text
  storeId        String?
  store          Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId, date])
}

model StockEntryLog {
  id               String   @id @default(uuid())
  date             DateTime @default(now())
  supplierId       String
  supplierName     String
  items            Json     // Array<{ productId: string, productName: string, quantity: number, cost: number }>
  totalCost        Float
  totalItems       Float
  registeredByUid  String
  registeredByName String
  purchaseOrderId  String?
  storeId          String?
  store            Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId, date])
}

model ProductChangeLog {
  id             String   @id @default(uuid())
  date           DateTime @default(now())
  productId      String
  productName    String
  changedByUid   String
  changedByName  String
  changes        Json     // Array<{ field: string, oldValue: any, newValue: any }>
  storeId        String?
  store          Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId, date])
}

model AccountsPayable {
  id               String    @id @default(uuid())
  description      String
  amount           Float
  category         String?   // 'Aluguel' | 'Energia' | 'Água' | 'Internet' | 'Fornecedor' | 'Salários' | 'Impostos' | 'Outros'
  dateCreated      DateTime  @default(now())
  dueDate          DateTime
  paymentDate      DateTime?
  status           String    // 'Pendente' | 'Pago' | 'Vencido'
  supplierId       String?
  supplierName     String?
  registeredByUid  String
  registeredByName String
  cashSessionId    String?
  storeId          String?
  store            Store?    @relation(fields: [storeId], references: [id])

  @@index([storeId, dueDate])
}

model PurchaseOrder {
  id               String    @id @default(uuid())
  supplierId       String
  supplierName     String
  dateCreated      DateTime  @default(now())
  dateExpected     DateTime
  dateReceived     DateTime?
  status           String    // 'Pendente' | 'Recebido Parcialmente' | 'Recebido' | 'Cancelado'
  items            Json      // Array<{ productId: string, productName: string, quantityOrdered: number, cost: number, quantityReceived: number }>
  totalCost        Float
  registeredByUid  String
  registeredByName String
  notes            String?   @db.Text
  storeId          String?
  store            Store?    @relation(fields: [storeId], references: [id])

  @@index([storeId, dateCreated])
}

model AuditLog {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  action    String
  details   String   @db.Text
  userUid   String
  userName  String
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])

  @@index([storeId, date])
}
